# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：开源版不含 /api/interpret 等后端接口，下面这组配置只在你自己实现了接口后才会用到；
# 只想排盘、看命盘的话不用填。
# AI_PROVIDER=deepseek (bản gốc, route hỏi đáp tiếng Việt không dùng)
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Bản Việt Nam (fork tranvannam3009-cell) ───
# Hỏi đáp AI (app/api/interpret/route.ts): AI_PROVIDER=gemini hoặc anthropic
AI_PROVIDER=gemini
# Google Gemini: lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Model mặc định gemini-3.5-flash-lite (nhanh ~1–2 giây). gemini-3.5-flash sâu hơn nhưng chậm (~1 phút)
# GEMINI_MODEL=gemini-3.5-flash-lite
# Claude (khi AI_PROVIDER=anthropic): lấy key tại https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
# vn = lập lá số theo âm lịch Việt Nam (UTC+7); bỏ trống hoặc cn = âm lịch Trung Quốc như bản gốc
NEXT_PUBLIC_ZIWEI_CALENDAR=vn
